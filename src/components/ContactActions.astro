---
import { PUBLIC_CONTACT_EMAIL, contactDetails } from '../lib/site-contact.js';
const contact = contactDetails(PUBLIC_CONTACT_EMAIL, Astro.props.subject);
---
{contact && (
  <div class="contact-actions" data-public-contact data-email={contact.email} role="group" aria-label="Contact the developer">
    <p class="contact-address">{contact.email}</p>
    <div class="contact-buttons">
      <a href={contact.href}>Email Leo <span aria-hidden="true">↗</span></a>
      <button type="button" data-copy-contact hidden>Copy email</button>
    </div>
    <p class="copy-status" data-copy-status role="status" aria-live="polite"></p>
  </div>
)}
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-public-contact]')) {
    const button = root.querySelector<HTMLButtonElement>('[data-copy-contact]');
    const status = root.querySelector<HTMLElement>('[data-copy-status]');
    if (!button || !status) continue;
    button.hidden = false;
    button.addEventListener('click', async () => {
      button.disabled = true;
      status.textContent = '';
      try {
        if (!root.dataset.email || !navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(root.dataset.email);
        status.textContent = 'Email address copied.';
      } catch {
        status.textContent = 'Copy is unavailable. Select and copy the address above.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
<style>
  .contact-actions { margin: 0 0 20px; max-width: 100%; }
  .contact-address { margin: 0 0 12px; overflow-wrap: anywhere; font-size: .92rem; user-select: text; }
  .contact-buttons { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .contact-buttons a, .contact-buttons button { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 44px; padding: 9px 14px; border: 1px solid currentColor; border-radius: 11px; background: transparent; color: inherit; font: inherit; font-size: .82rem; text-decoration: none; cursor: pointer; }
  .contact-buttons button[hidden] { display: none; }
  .contact-buttons button:disabled { opacity: .65; cursor: wait; }
  .copy-status { font-size: .76rem; line-height: 1.5; margin: 8px 0 0; }
  .copy-status:empty { display: none; }
</style>
