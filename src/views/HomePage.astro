---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactActions from '../components/ContactActions.astro';
import AIStoryReal3DFan from '../components/AIStoryReal3DFan.astro';
import AIStoryDemoVideo from '../components/AIStoryDemoVideo.astro';

import { getMessages, localizedPath, format } from '../i18n/index.js';
const { locale = 'en' } = Astro.props;
const { home, common, contact } = getMessages(locale);
const { systems, principles } = home;
const productPath = localizedPath(locale, 'aistory');
---

<SiteLayout locale={locale} page="home">
<main id="top">
  <section class="hero">
    <div class="hero-copy">
      <div class="status"><span></span> {home.status}</div>
      <h1>{home.heroTitle}<br />{home.heroPrefix}<em>{home.heroAccent}</em></h1>
      <p class="hero-lead">
        {home.lead}
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">{home.selectedAction} <span>↘</span></a>
        <a class="button button-quiet" href="https://github.com/leomonan" target="_blank" rel="noreferrer">GitHub <span>↗</span></a>
      </div>
    </div>

    <aside class="hero-panel" aria-label={home.current}>
      <div class="hero-panel-top">
        <span>{home.current}</span>
        <span>2026</span>
      </div>
      <div class="signal" aria-hidden="true">
        <div class="signal-ring ring-a"></div>
        <div class="signal-ring ring-b"></div>
        <div class="signal-core">LM</div>
        <i class="signal-dot dot-a"></i>
        <i class="signal-dot dot-b"></i>
        <i class="signal-dot dot-c"></i>
      </div>
      <div class="focus-list">
        <a class="focus-row focus-link" href={productPath}><span>AIStory</span><small>{home.focusStory}</small></a>
        <a class="focus-row focus-link" href="#colook"><span>Colook</span><small>{home.focusColook}</small></a>
        <a class="focus-row focus-link" href="#easytranslator"><span>EasyTranslator</span><small>{home.focusTranslator}</small></a>
      </div>
    </aside>
  </section>

  <section class="section work" id="work">
    <div class="section-intro">
      <div>
        <p class="mini-label">{home.selected}</p>
        <h2>{home.productsTitle}</h2>
      </div>
      <p class="section-note">
        {home.productsLead}
      </p>
    </div>

    <article class="flagship-card">
      <div class="flagship-copy">
        <div class="card-meta">
          <span>{home.flagship}</span>
          <span>{common.active}</span>
        </div>
        <div class="flagship-text">
          <p class="project-kicker">{home.storyKicker}</p>
          <h3>AIStory</h3>
          <p class="project-tagline">{home.storyTagline}</p>
          <p class="project-description">
            {home.storyDescription}
          </p>
          <ul class="tag-list" aria-label={home.storyTopics}>
            <li>{home.tagWorlds}</li>
            <li>{home.tagCharacters}</li>
            <li>{home.tagVoice}</li>
            <li>{home.tagContinuity}</li>
          </ul>
          <div class="flagship-actions">
            <a class="button button-primary" href={productPath} data-aistory-entry>
              {home.explore} <span aria-hidden="true">→</span>
            </a>
            <span>{home.overview}</span>
          </div>
        </div>
      </div>

      <AIStoryReal3DFan locale={locale} />
    </article>

    <AIStoryDemoVideo locale={locale} />

    <div class="product-pair">
      <article class="product-card colook-card" id="colook">
        <div class="card-meta">
          <span>{home.desktop}</span>
          <span>{home.early}</span>
        </div>
        <div class="product-visual terminal-visual" aria-hidden="true">
          <div class="terminal-top"><span></span><span></span><span></span></div>
          <div class="agent-row active"><b>Codex</b><small>{home.running}</small><i></i></div>
          <div class="agent-row"><b>Claude Code</b><small>{home.waiting}</small><i></i></div>
          <div class="agent-row"><b>Cursor Agent</b><small>{home.ready}</small><i></i></div>
        </div>
        <div class="product-copy">
          <p class="project-kicker">{home.colookKicker}</p>
          <h3>Colook</h3>
          <p class="project-tagline">{home.colookTagline}</p>
          <p>
            {home.colookDescription}
          </p>
          <a class="text-link" href="https://github.com/leomonan/co-look-downloads/releases" target="_blank" rel="noreferrer">{common.releases} <span>↗</span></a>
        </div>
      </article>

      <article class="product-card translator-card" id="easytranslator">
        <div class="card-meta">
          <span>03 / macOS</span>
          <span>{home.shipped}</span>
        </div>
        <div class="product-visual translator-visual" aria-hidden="true">
          <div class="selection-line" lang="en">You don’t have to leave your flow to understand it.</div>
          <div class="translation-popover">
            <div class="popover-label">{home.naturalMeaning}</div>
            <strong lang="zh-Hans">理解，不必离开当前工作流。</strong>
            <div class="popover-grid"><span>{home.context}</span><span>{home.terms}</span><span>{home.explain}</span></div>
          </div>
        </div>
        <div class="product-copy">
          <p class="project-kicker">{home.translatorKicker}</p>
          <h3>EasyTranslator</h3>
          <p class="project-tagline">{home.translatorTagline}</p>
          <p>
            {home.translatorDescription}
          </p>
          <a class="text-link" href="https://github.com/leomonan/EasyTranslator-downloads/releases" target="_blank" rel="noreferrer">{common.releases} <span>↗</span></a>
        </div>
      </article>
    </div>
  </section>

  <section class="section systems" id="systems">
    <div class="section-intro systems-intro">
      <div>
        <p class="mini-label">{home.systemsKicker}</p>
        <h2>{home.systemsTitle}</h2>
      </div>
      <p class="section-note">
        {home.systemsDescription}
      </p>
    </div>

    <div class="systems-list">
      {systems.map((system) => (
        <article class="system-row">
          <span class="system-number">{system.number}</span>
          <div class="system-name">
            <small>{system.type}</small>
            <h3>{system.name}</h3>
          </div>
          <p>{system.description}</p>
          <ul class="system-tags" aria-label={format(common.topics, { name: system.name })}>
            {system.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section thinking" id="thinking">
    <div class="section-intro compact">
      <div>
        <p class="mini-label">{home.principlesKicker}</p>
        <h2>{home.principlesTitle}</h2>
      </div>
    </div>

    <div class="principle-grid">
      {principles.map(([number, title, body]) => (
        <article class="principle-card">
          <span class="principle-number">{number}</span>
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="about-wrap" id="about">
    <div class="about-card">
      <div class="about-kicker">Leo Monan / 2026</div>
      <div class="about-grid">
        <h2>{home.aboutTitle}<br />{home.aboutAccent}</h2>
        <div class="about-copy">
          <p class="about-lead">
            {home.aboutLead}
          </p>
          <p>
            {home.aboutDescription}
          </p>
          <ContactActions locale={locale} subject={contact.homeSubject} />
          <a href="https://github.com/leomonan" target="_blank" rel="noreferrer">{home.follow} <span>↗</span></a>
        </div>
      </div>
    </div>
  </section>
</main>
</SiteLayout>

<style>
.hero {
    min-height: 690px;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
    gap: clamp(56px, 8vw, 108px);
    align-items: center;
    padding: clamp(72px, 8vw, 118px) 0 clamp(82px, 9vw, 124px);
  }

  .status, .mini-label { margin: 0; color: var(--muted); text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.68rem; font-weight: 650; }
  .status { display: flex; align-items: center; gap: 9px; }
  .status span { width: 7px; height: 7px; border-radius: 50%; background: var(--blue); box-shadow: 0 0 0 4px rgba(53, 88, 255, 0.09); }

  h1 {
    max-width: 830px;
    margin: 28px 0 32px;
    font-size: clamp(4rem, 7.1vw, 6.9rem);
    line-height: 0.95;
    letter-spacing: -0.067em;
    font-weight: 650;
  }

  h1 em { font-family: Georgia, "Times New Roman", serif; font-weight: 400; letter-spacing: -0.05em; }
  .hero-lead { max-width: 680px; margin: 0; color: #484a45; font-size: clamp(1.03rem, 1.45vw, 1.24rem); line-height: 1.64; letter-spacing: -0.018em; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }


  .hero-panel {
    min-height: 500px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: 32px;
    background:
      linear-gradient(rgba(255,255,255,0.8), rgba(255,255,255,0.8)),
      repeating-linear-gradient(90deg, transparent 0 31px, rgba(22,23,21,0.035) 31px 32px),
      repeating-linear-gradient(0deg, transparent 0 31px, rgba(22,23,21,0.035) 31px 32px);
  }

  .hero-panel-top, .card-meta { display: flex; justify-content: space-between; gap: 24px; color: var(--muted); font-size: 0.67rem; text-transform: uppercase; letter-spacing: 0.1em; }
  .signal { min-height: 304px; position: relative; display: grid; place-items: center; }
  .signal-core { z-index: 3; display: grid; place-items: center; width: 92px; height: 92px; border-radius: 28px; background: var(--ink); color: white; font-weight: 760; letter-spacing: -0.06em; box-shadow: 0 18px 52px rgba(22,23,21,0.16); }
  .signal-ring { position: absolute; border: 1px solid rgba(22,23,21,0.16); border-radius: 50%; }
  .ring-a { width: 255px; height: 142px; transform: rotate(-18deg); }
  .ring-b { width: 332px; height: 190px; transform: rotate(24deg); opacity: 0.62; }
  .signal-dot { position: absolute; border-radius: 50%; box-shadow: 0 0 0 5px rgba(53,88,255,0.1); }
  .dot-a { width: 15px; height: 15px; background: var(--blue); top: 76px; right: 68px; }
  .dot-b { width: 11px; height: 11px; background: #ff7448; bottom: 58px; left: 70px; box-shadow: 0 0 0 5px rgba(255,116,72,0.1); }
  .dot-c { width: 8px; height: 8px; background: #38bf82; top: 112px; left: 52px; box-shadow: 0 0 0 5px rgba(56,191,130,0.1); }
  .focus-list { border-top: 1px solid var(--line); padding-top: 14px; }
  .focus-row { display: flex; justify-content: space-between; gap: 24px; padding: 10px 0; border-bottom: 1px solid rgba(22,23,21,0.08); font-size: 0.9rem; }
  .focus-row:last-child { border-bottom: 0; }
  .focus-row small { color: var(--muted); font-size: 0.76rem; text-align: right; }

  .section { padding: clamp(92px, 10vw, 148px) 0; }
  .section-intro { display: grid; grid-template-columns: 1.35fr 0.65fr; gap: 70px; align-items: end; margin-bottom: clamp(44px, 6vw, 78px); }
  .section-intro.compact { grid-template-columns: 1fr; }
  .section-intro h2, .about-card h2 { margin: 13px 0 0; font-size: clamp(2.8rem, 5vw, 5.2rem); line-height: 0.98; letter-spacing: -0.058em; font-weight: 620; }
  .section-note { margin: 0; color: var(--muted); font-size: 0.98rem; line-height: 1.65; }

  .flagship-card {
    display: grid;
    grid-template-columns: minmax(0, 0.76fr) minmax(560px, 1.24fr);
    gap: clamp(18px, 3vw, 42px);
    min-height: 650px;
    padding: clamp(26px, 3.5vw, 44px);
    border: 1px solid #cfd5ff;
    border-radius: 34px;
    background: linear-gradient(135deg, #f1f3ff 0%, #e8edff 100%);
    overflow: hidden;
  }

  .flagship-copy { display: flex; flex-direction: column; }
  .flagship-text { margin: auto 0; padding: 52px 0 28px; }
  .project-kicker { margin: 0 0 12px; color: var(--muted); font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .flagship-card h3, .product-card h3 { margin: 0; line-height: 0.96; letter-spacing: -0.06em; font-weight: 650; }
  .flagship-card h3 { font-size: clamp(3.5rem, 6vw, 6.3rem); }
  .product-card h3 { font-size: clamp(2.7rem, 4vw, 4.2rem); }
  .project-tagline { margin: 16px 0 18px; font-family: Georgia, "Times New Roman", serif; font-size: clamp(1.35rem, 2vw, 1.9rem); font-style: italic; letter-spacing: -0.025em; }
  .project-description, .product-copy > p:not(.project-kicker):not(.project-tagline) { margin: 0; color: #4d5049; font-size: 0.95rem; line-height: 1.68; }
  .tag-list { list-style: none; display: flex; flex-wrap: wrap; gap: 7px; margin: 28px 0 0; padding: 0; }
  .tag-list li, .system-tags li { padding: 7px 10px; border: 1px solid rgba(22,23,21,0.13); border-radius: 999px; color: var(--muted); background: rgba(255,255,255,0.46); font-size: 0.67rem; }

  .product-pair { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 18px; }
  .product-card { display: flex; flex-direction: column; min-height: 610px; padding: clamp(26px, 3vw, 38px); border: 1px solid var(--line); border-radius: 30px; overflow: hidden; }
  .colook-card { background: var(--mint); border-color: #bce8d3; }
  .translator-card { background: var(--peach); border-color: #f0d2c1; }
  .product-visual { min-height: 230px; margin: 38px 0 42px; border-radius: 22px; overflow: hidden; }
  .terminal-visual { padding: 18px; background: #17231e; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.06); }
  .terminal-top { display: flex; gap: 6px; padding-bottom: 18px; border-bottom: 1px solid rgba(255,255,255,0.08); }
  .terminal-top span { width: 7px; height: 7px; border-radius: 50%; background: #65746d; }
  .agent-row { display: grid; grid-template-columns: 1fr auto 9px; gap: 12px; align-items: center; padding: 18px 4px; border-bottom: 1px solid rgba(255,255,255,0.08); color: #dce7e1; }
  .agent-row b { font-size: 0.83rem; font-weight: 620; }
  .agent-row small { color: #85978d; font-size: 0.68rem; }
  .agent-row i { width: 8px; height: 8px; border-radius: 50%; background: #66756e; }
  .agent-row.active { color: white; }
  .agent-row.active i { background: #5fe09d; box-shadow: 0 0 0 4px rgba(95,224,157,0.12); }

  .translator-visual { position: relative; padding: 28px; background: #fff8f3; border: 1px solid rgba(120,73,45,0.1); }
  .selection-line { max-width: 86%; color: #755a4a; font-family: Georgia, "Times New Roman", serif; font-size: 1.1rem; line-height: 1.5; }
  .translation-popover { position: absolute; right: 24px; bottom: 22px; width: min(80%, 330px); padding: 20px; border-radius: 18px; background: white; box-shadow: 0 18px 42px rgba(89,55,34,0.13); }
  .popover-label { margin-bottom: 8px; color: #b28368; text-transform: uppercase; letter-spacing: 0.09em; font-size: 0.6rem; }
  .translation-popover strong { display: block; color: #4f382b; font-size: 0.94rem; line-height: 1.45; }
  .popover-grid { display: flex; gap: 6px; margin-top: 16px; }
  .popover-grid span { padding: 5px 8px; border-radius: 999px; background: #fff2e9; color: #9b7259; font-size: 0.6rem; }
  .product-copy { margin-top: auto; }
  .product-copy > p:not(.project-kicker):not(.project-tagline) { max-width: 570px; }
  .text-link { display: inline-flex; gap: 9px; margin-top: 24px; padding-bottom: 3px; border-bottom: 1px solid rgba(22,23,21,0.45); text-decoration: none; font-size: 0.82rem; font-weight: 660; }

  .systems { padding-top: clamp(70px, 8vw, 116px); }
  .systems-intro { margin-bottom: 34px; }
  .systems-list { border-top: 1px solid var(--line); }
  .system-row { display: grid; grid-template-columns: 48px minmax(220px, 0.85fr) minmax(300px, 1.25fr) minmax(180px, 0.7fr); gap: 28px; align-items: center; padding: 30px 0; border-bottom: 1px solid var(--line); transition: padding 160ms ease; }
  .system-row:hover { padding-left: 10px; padding-right: 10px; }
  .system-number { color: var(--blue); font-size: 0.7rem; font-weight: 750; }
  .system-name small { display: block; margin-bottom: 6px; color: var(--muted); font-size: 0.67rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .system-name h3 { margin: 0; font-size: clamp(1.7rem, 2.8vw, 2.55rem); letter-spacing: -0.045em; font-weight: 620; }
  .system-row > p { margin: 0; color: var(--muted); font-size: 0.89rem; line-height: 1.62; }
  .system-tags { list-style: none; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px; margin: 0; padding: 0; }

  .thinking { padding-top: clamp(70px, 8vw, 118px); }
  .principle-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .principle-card { min-height: 300px; display: flex; flex-direction: column; padding: 28px; border: 1px solid var(--line); border-radius: 24px; background: rgba(255,255,255,0.54); }
  .principle-number { color: var(--blue); font-size: 0.72rem; font-weight: 720; }
  .principle-card h3 { margin: auto 0 18px; font-size: clamp(1.65rem, 2.4vw, 2.4rem); line-height: 1.08; letter-spacing: -0.045em; font-weight: 610; }
  .principle-card p { margin: 0; color: var(--muted); line-height: 1.62; font-size: 0.92rem; }

  .about-wrap { padding: 36px 0 clamp(90px, 10vw, 140px); }
  .about-card { padding: clamp(34px, 5vw, 68px); border-radius: 32px; background: var(--dark); color: white; }
  .about-kicker { color: #9b9d96; text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.68rem; }
  .about-grid { display: grid; grid-template-columns: 1fr 0.85fr; gap: clamp(60px, 9vw, 140px); align-items: end; margin-top: 66px; }
  .about-card h2 { color: white; }
  .about-copy { max-width: 550px; }
  .about-lead { margin: 0 0 24px; font-size: clamp(1.4rem, 2.1vw, 1.9rem); line-height: 1.35; letter-spacing: -0.035em; }
  .about-copy > p:not(.about-lead) { margin: 0 0 30px; color: #b8bab3; line-height: 1.7; font-size: 0.95rem; }
  .about-copy a { display: inline-flex; gap: 10px; color: white; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.5); padding-bottom: 4px; font-size: 0.88rem; }



  @media (max-width: 1100px) {
    .flagship-card { grid-template-columns: 1fr; }
  }

  @media (max-width: 1020px) {
    .hero { grid-template-columns: 1fr; min-height: auto; gap: 48px; padding-top: 72px; }
    .hero-panel { min-height: 0; padding: 22px; }
    .hero-panel .signal { display: none; }
    .hero { gap: 28px; }
    .focus-list { padding-top: 8px; }
    .focus-row { min-height: 48px; align-items: center; }
    .system-row { grid-template-columns: 42px minmax(180px, 0.8fr) 1.2fr; }
    .system-tags { grid-column: 2 / -1; justify-content: flex-start; }
  }

  @media (max-width: 820px) {
    .section-intro { grid-template-columns: 1fr; gap: 24px; }
    .product-pair { grid-template-columns: 1fr; }
    .product-card { min-height: 560px; }
    .principle-grid { grid-template-columns: 1fr; }
    .principle-card { min-height: 240px; }
    .about-grid { grid-template-columns: 1fr; gap: 44px; }
    .system-row { grid-template-columns: 40px 1fr; }
    .system-row > p, .system-tags { grid-column: 2; }
  }

  @media (max-width: 620px) {

    .hero { padding-top: 40px; padding-bottom: 46px; gap: 24px; }
    h1 { font-size: clamp(3.45rem, 16.5vw, 5.3rem); }
    .hero-lead { font-size: 1rem; }
    .hero-panel { min-height: 0; padding: 22px; border-radius: 24px; }
    .ring-b { width: 278px; height: 160px; }
    .ring-a { width: 210px; height: 118px; }
    .dot-a { right: 40px; }
    .dot-b { left: 46px; }

    .section { padding: 82px 0; }
    .section-intro h2, .about-card h2 { font-size: clamp(2.7rem, 13vw, 4rem); }
    .flagship-card { min-height: 0; padding: 24px; border-radius: 24px; }
    .flagship-card h3 { font-size: 4rem; }
    .flagship-text { padding: 46px 0 34px; }

    .product-card { min-height: 530px; padding: 24px; border-radius: 24px; }
    .product-card h3 { font-size: 3.15rem; }
    .product-visual { margin-top: 30px; min-height: 210px; }
    .translation-popover { right: 16px; left: 16px; width: auto; }

    .system-row { gap: 16px; padding: 24px 0; }
    .system-row:hover { padding-left: 0; padding-right: 0; }
    .system-name h3 { font-size: 2rem; }
    .about-card { border-radius: 24px; }
    .about-grid { margin-top: 50px; }


  }



  .product-card[id] { scroll-margin-top: 24px; }
  .focus-link { text-decoration: none; }
  .focus-link:hover { color: var(--blue); }
  .flagship-actions { display: flex; align-items: flex-start; flex-direction: column; gap: 12px; margin-top: 30px; }
  .flagship-actions > span { color: var(--muted); font-size: .74rem; }
</style>
